import { useEffect, useState } from "react";
import Login from "./pages/Login";
import CrowdMonitoring from "./pages/CrowdMonitoring";
import Congestion from "./pages/Congestion";
import M2Dashboard from "./pages/M2Dashboard";
import {
  getStoredUser,
  logout,
  getCrowdSummary,
} from "./services/api";
import "./App.css";

const navigation = [
  { id: "dashboard", icon: "▦", label: "Dashboard" },
  { id: "crowd", icon: "◉", label: "Crowd Monitoring" },
  { id: "congestion", icon: "⌁", label: "Congestion" },
  { id: "m2", icon: "✳", label: "AI Analytics" },
];

// Published network information from official HMRL sources.
// These are network facts, not live passenger or crowd measurements.
const metroLines = [
  {
    name: "Red Line",
    route: "Miyapur → LB Nagar",
    color: "#f87171",
  },
  {
    name: "Blue Line",
    route: "Nagole → Raidurg",
    color: "#60a5fa",
  },
  {
    name: "Green Line",
    route: "JBS Parade Ground → MGBS",
    color: "#4ade80",
  },
];

function App() {
  const [user, setUser] = useState(getStoredUser());
  const [activePage, setActivePage] = useState("dashboard");
  const [crowdData, setCrowdData] = useState(null);
  const [dataLoading, setDataLoading] = useState(true);
  const [dataError, setDataError] = useState("");

  useEffect(() => {
    let cancelled = false;

    async function loadDashboardData() {
      try {
        setDataLoading(true);
        setDataError("");

        const crowd = await getCrowdSummary();

        if (!cancelled) {
          setCrowdData(crowd);
        }
      } catch (error) {
        if (!cancelled) {
          setDataError(
            error.message || "Unable to load dataset summary."
          );
        }
      } finally {
        if (!cancelled) {
          setDataLoading(false);
        }
      }
    }

    if (user) {
      loadDashboardData();
    } else {
      setDataLoading(false);
    }

    return () => {
      cancelled = true;
    };
  }, [user]);

  function handleLogin(loginData) {
    setUser({
      username: loginData.username,
      role: loginData.role,
    });
    setActivePage("dashboard");
  }

  function handleLogout() {
    logout();
    setUser(null);
    setCrowdData(null);
    setDataError("");
    setActivePage("dashboard");
  }

  if (!user) {
    return <Login onLogin={handleLogin} />;
  }

  const routeStatuses = crowdData?.route_status || [];

  const dangerous =
    routeStatuses.find((item) => item.status === "Dangerous")
      ?.count ?? 0;

  const congested =
    routeStatuses.find((item) => item.status === "Congested")
      ?.count ?? 0;

  const optimal =
    routeStatuses.find((item) => item.status === "Optimal")
      ?.count ?? 0;

  const total = crowdData?.total_records ?? 0;

  function renderDashboard() {
    return (
      <>
        <header className="topbar">
          <div>
            <p className="eyebrow">
              HYDERABAD METRO · OPERATIONS CENTER
            </p>
            <h1>Network Dashboard</h1>
            <p className="topbar-subtitle">
              Official network overview and monitoring tools.
            </p>
          </div>

          <div className="user-section">
            <span className="demo-pill">
              <span className="status-dot" />
              DEMONSTRATION ENVIRONMENT
            </span>

            <div className="user-avatar">
              {user.username?.charAt(0).toUpperCase() || "U"}
            </div>

            <div className="user-info">
              <strong>{user.username}</strong>
              <span>{user.role}</span>
            </div>

            <button
              className="logout-button"
              onClick={handleLogout}
            >
              Log out
            </button>
          </div>
        </header>

        <section className="hero-banner">
          <div className="hero-copy">
            <span className="hero-kicker">
              METRO INTELLIGENCE PLATFORM
            </span>

            <h2>Good to see you, {user.username}.</h2>

            <p>
              Explore Hyderabad Metro's published network
              information and review the data available to
              your monitoring and analytics tools.
            </p>

            <button
              className="primary-button"
              onClick={() => setActivePage("m2")}
            >
              Explore AI Analytics <span>↗️</span>
            </button>
          </div>

          <div className="hero-art" aria-hidden="true">
            <div className="orbit orbit-one" />
            <div className="orbit orbit-two" />
            <div className="orbit-core">MF</div>
            <span className="orbit-node node-one">AI</span>
            <span className="orbit-node node-two">3</span>
            <span className="orbit-node node-three">↗️</span>
          </div>
        </section>

        <div className="section-heading">
          <div>
            <p className="eyebrow">OFFICIAL NETWORK PROFILE</p>
            <h2>Hyderabad Metro Network Overview</h2>
          </div>

          <span className="muted-label">Published network data</span>
        </div>

        {dataError && (
          <div className="notice notice-error">
            <strong>Monitoring summary unavailable</strong>
            <span>{dataError}</span>
          </div>
        )}

        <section className="stats-grid">
          <article className="stat-card">
            <div className="stat-icon cyan">↔️</div>
            <div className="stat-content">
              <span className="stat-label">Phase I network length</span>
              <strong className="stat-value">69 km</strong>
              <small>Published by HMRL</small>
            </div>
          </article>

          <article className="stat-card">
            <div className="stat-icon purple">≋</div>
            <div className="stat-content">
              <span className="stat-label">Operational corridors</span>
              <strong className="stat-value">3</strong>
              <small>Red, Blue and Green Lines</small>
            </div>
          </article>

          <article className="stat-card">
            <div className="stat-icon green">⇄</div>
            <div className="stat-content">
              <span className="stat-label">Interchange stations</span>
              <strong className="stat-value">3</strong>
              <small>Ameerpet, MGBS and Parade Grounds</small>
            </div>
          </article>

          <article className="stat-card">
            <div className="stat-icon amber">◷</div>
            <div className="stat-content">
              <span className="stat-label">Live crowd feed</span>
              <strong className="stat-value">Unavailable</strong>
              <small>No verified live crowd feed connected</small>
            </div>
          </article>
        </section>

        <p className="data-disclaimer">
          <span>ⓘ</span>
          Network facts are sourced from official HMRL
          publications. Crowd levels, passenger counts and
          delays are not represented as live data here.
        </p>

        <section className="dashboard-grid">
          <article className="panel">
            <div className="panel-header">
              <div>
                <p className="eyebrow">PHASE I ROUTES</p>
                <h3>Metro Corridors</h3>
                <p>Published route endpoints from HMRL.</p>
              </div>
              <span className="panel-icon">⇄</span>
            </div>

            <div className="route-list">
              {metroLines.map((line) => (
                <div
                  className="distribution-item"
                  key={line.name}
                >
                  <div className="distribution-label">
                    <span>
                      <i
                        className="legend-dot"
                        style={{ backgroundColor: line.color }}
                      />
                      {line.name}
                    </span>
                  </div>
                  <strong>{line.route}</strong>
                </div>
              ))}
            </div>

            <p className="data-disclaimer">
              Route information may change. Refer to HMRL
              for the latest official service information.
            </p>

            <a
              href="https://hmrl.co.in/train-timings/"
              target="_blank"
              rel="noreferrer"
              className="shortcut-row"
            >
              <span className="shortcut-icon cyan">↗️</span>
              <span className="shortcut-copy">
                <strong>Official route and train information</strong>
                <small>Open the HMRL website</small>
              </span>
              <span className="shortcut-arrow">↗️</span>
            </a>
          </article>

          <article className="panel">
            <div className="panel-header">
              <div>
                <p className="eyebrow">DATA TRANSPARENCY</p>
                <h3>Monitoring Status</h3>
                <p>What this application can currently verify.</p>
              </div>
              <span className="panel-icon">◫</span>
            </div>

            <div className="overview-list">
              <div className="overview-item">
                <span>Official network profile</span>
                <strong className="online">● Published</strong>
              </div>

              <div className="overview-item">
                <span>Crowd dataset API</span>
                <strong>
                  {dataLoading
                    ? "Loading"
                    : crowdData
                      ? "● Connected"
                      : "Unavailable"}
                </strong>
              </div>

              <div className="overview-item">
                <span>Live passenger counts</span>
                <strong>Not connected</strong>
              </div>

              <div className="overview-item">
                <span>Live train delays</span>
                <strong>Not connected</strong>
              </div>
            </div>

            <p className="data-disclaimer">
              A connected dataset does not necessarily represent
              current Hyderabad Metro operations.
            </p>
          </article>
        </section>

        <section className="panel">
          <div className="panel-header">
            <div>
              <p className="eyebrow">SOURCE REFERENCES</p>
              <h3>Official Hyderabad Metro Information</h3>
              <p>Use these sources to verify published network details.</p>
            </div>
          </div>

          <a
            className="shortcut-row"
            href="https://hmrl.co.in/about-hmrl/"
            target="_blank"
            rel="noreferrer"
          >
            <span className="shortcut-icon cyan">↗️</span>
            <span className="shortcut-copy">
              <strong>About Hyderabad Metro Rail</strong>
              <small>Network length and corridor overview</small>
            </span>
            <span className="shortcut-arrow">↗️</span>
          </a>

          <a
            className="shortcut-row"
            href="https://hmrl.co.in/open-data/"
            target="_blank"
            rel="noreferrer"
          >
            <span className="shortcut-icon purple">↗️</span>
            <span className="shortcut-copy">
              <strong>HMRL Open Data</strong>
              <small>Official published transit data and terms</small>
            </span>
            <span className="shortcut-arrow">↗️</span>
          </a>

          <a
            className="shortcut-row"
            href="https://ltmetro.com/wp-content/uploads/2025/01/HMRRouteMap_new.pdf"
            target="_blank"
            rel="noreferrer"
          >
            <span className="shortcut-icon green">↗️</span>
            <span className="shortcut-copy">
              <strong>Official Metro Network Map</strong>
              <small>Published route map PDF</small>
            </span>
            <span className="shortcut-arrow">↗️</span>
          </a>
        </section>

        <section className="dashboard-grid">
          <article className="panel">
            <div className="panel-header">
              <div>
                <p className="eyebrow">CONNECTED DATASET</p>
                <h3>Route Classification Breakdown</h3>
                <p>
                  Existing crowd API results, not verified
                  live Hyderabad Metro crowd measurements.
                </p>
              </div>
              <span className="panel-icon">◫</span>
            </div>

            {[
              {
                label: "Dangerous",
                value: dangerous,
                color: "danger",
              },
              {
                label: "Congested",
                value: congested,
                color: "warning",
              },
              {
                label: "Optimal",
                value: optimal,
                color: "success",
              },
            ].map((item) => {
              const percent = total
                ? Math.min(100, (item.value / total) * 100)
                : 0;

              return (
                <div
                  className="distribution-item"
                  key={item.label}
                >
                  <div className="distribution-label">
                    <span>
                      <i className={`legend-dot ${item.color}`} />
                      {item.label}
                    </span>
                    <strong>
                      {dataLoading
                        ? "…"
                        : item.value.toLocaleString()}
                    </strong>
                  </div>

                  <div className="progress-track">
                    <div
                      className={`progress-fill ${item.color}`}
                      style={{ width: `${percent}%` }}
                    />
                  </div>

                  <small>
                    {percent.toFixed(1)}% of dataset records
                  </small>
                </div>
              );
            })}
          </article>

          <article className="panel">
            <div className="panel-header">
              <div>
                <p className="eyebrow">PLATFORM</p>
                <h3>Operations Shortcuts</h3>
                <p>Open your existing monitoring tools.</p>
              </div>
              <span className="panel-icon">⌘</span>
            </div>

            <button
              className="shortcut-row"
              onClick={() => setActivePage("crowd")}
            >
              <span className="shortcut-icon cyan">◉</span>
              <span className="shortcut-copy">
                <strong>Crowd Monitoring</strong>
                <small>Inspect station conditions and alerts</small>
              </span>
              <span className="shortcut-arrow">↗️</span>
            </button>

            <button
              className="shortcut-row"
              onClick={() => setActivePage("congestion")}
            >
              <span className="shortcut-icon amber">⌁</span>
              <span className="shortcut-copy">
                <strong>Congestion Tracking</strong>
                <small>Review existing traffic summaries</small>
              </span>
              <span className="shortcut-arrow">↗️</span>
            </button>

            <button
              className="shortcut-row"
              onClick={() => setActivePage("m2")}
            >
              <span className="shortcut-icon purple">✳</span>
              <span className="shortcut-copy">
                <strong>AI Analytics</strong>
                <small>Forecasts, delays and recommendations</small>
              </span>
              <span className="shortcut-arrow">↗️</span>
            </button>
          </article>
        </section>

        <footer className="app-footer">
          <span>AI-MetroFlow <b>v1.0</b></span>
          <span>
            Independent demonstration using published network information
          </span>
        </footer>
      </>
    );
  }

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="logo">
          <div className="logo-icon">M</div>
          <div>
            <h1>AI-MetroFlow</h1>
            <p>METRO INTELLIGENCE</p>
          </div>
        </div>

        <div className="sidebar-label">WORKSPACE</div>

        <nav className="sidebar-nav" aria-label="Main navigation">
          {navigation.map((item) => (
            <button
              key={item.id}
              type="button"
              className={`nav-item ${
                activePage === item.id ? "active" : ""
              }`}
              onClick={() => setActivePage(item.id)}
              aria-current={
                activePage === item.id ? "page" : undefined
              }
            >
              <span className="nav-icon">{item.icon}</span>
              <span>{item.label}</span>
              {activePage === item.id && (
                <span className="nav-active-mark" />
              )}
            </button>
          ))}
        </nav>

        <div className="sidebar-bottom">
          <div className="sidebar-demo-card">
            <span className="status-dot" />
            <div>
              <strong>Demo environment</strong>
              <small>Live operational feed not connected</small>
            </div>
          </div>

          <div className="sidebar-user">
            <div className="user-avatar small">
              {user.username?.charAt(0).toUpperCase() || "U"}
            </div>

            <div className="user-info">
              <strong>{user.username}</strong>
              <span>{user.role}</span>
            </div>

            <button
              className="sidebar-logout"
              onClick={handleLogout}
              aria-label="Log out"
              title="Log out"
            >
              ↗️
            </button>
          </div>
        </div>
      </aside>

      <main className="main-content">
        {activePage === "dashboard" && renderDashboard()}
        {activePage === "crowd" && <CrowdMonitoring />}
        {activePage === "congestion" && <Congestion />}
        {activePage === "m2" && <M2Dashboard />}
      </main>
    </div>
  );
}

export default App;